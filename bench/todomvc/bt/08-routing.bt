# test.describe('Routing')
use common.bt

before each
  goto ${APP}
  run createDefaultTodos
  # make sure the app had a chance to save updated todos in storage
  # before navigating to a new view, otherwise the items can get lost :(
  # in some frameworks like Durandal
  run checkTodosInLocalStorage "${TODO0}"

scenario "Routing: should allow me to display active items"
  check --selector "[data-testid=todo-item]:nth-child(2) *" --role checkbox
  run checkNumberOfCompletedTodosInLocalStorage 1
  click --role link --name Active
  expect --selector "[data-testid=todo-item]" count is 2
  expect --testid todo-item --nth 0 text is "${TODO0}"
  expect --testid todo-item --nth 1 text is "${TODO2}"

scenario "Routing: should respect the back button"
  check --selector "[data-testid=todo-item]:nth-child(2) *" --role checkbox
  run checkNumberOfCompletedTodosInLocalStorage 1
  # test.step('Showing all items')
  click --role link --name All
  expect --selector "[data-testid=todo-item]" count is 3
  # test.step('Showing active items')
  click --role link --name Active
  # test.step('Showing completed items')
  click --role link --name Completed
  expect --selector "[data-testid=todo-item]" count is 1
  back
  expect --selector "[data-testid=todo-item]" count is 2
  back
  expect --selector "[data-testid=todo-item]" count is 3

scenario "Routing: should allow me to display completed items"
  check --selector "[data-testid=todo-item]:nth-child(2) *" --role checkbox
  run checkNumberOfCompletedTodosInLocalStorage 1
  click --role link --name Completed
  expect --selector "[data-testid=todo-item]" count is 1

scenario "Routing: should allow me to display all items"
  check --selector "[data-testid=todo-item]:nth-child(2) *" --role checkbox
  run checkNumberOfCompletedTodosInLocalStorage 1
  click --role link --name Active
  click --role link --name Completed
  click --role link --name All
  expect --selector "[data-testid=todo-item]" count is 3

scenario "Routing: should highlight the currently applied filter"
  expect --role link --name All attr class is selected
  # create locators for active and completed links
  click --role link --name Active
  # Page change - active items.
  expect --role link --name Active attr class is selected
  click --role link --name Completed
  # Page change - completed items.
  expect --role link --name Completed attr class is selected
